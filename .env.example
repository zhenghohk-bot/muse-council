# LLM 接入（Chat-Completions 兼容）。缺 OPENAI_API_KEY 时全流程自动降级到规则版，仍可完整演示。
OPENAI_API_KEY=
# 生成模型。OpenAI 默认可用 gpt-4.1-mini；接火山方舟时填对应模型名（如 deepseek-v4-pro）。
OPENAI_MODEL=gpt-4.1-mini
# 兼容网关地址，默认 https://api.openai.com/v1。接火山方舟（Ark）时改为：
# OPENAI_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
OPENAI_BASE_URL=
OPENAI_TIMEOUT_MS=90000

# 独立评测裁判（仅 npm run eval 使用，不会进入网页请求）。
EVAL_API_KEY=
EVAL_BASE_URL=
EVAL_JUDGE_MODEL=
EVAL_TIMEOUT_MS=90000

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
